*.exe
*.out
*.app
*.o
*.obj
*.lib
*.a
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.idb

# Explicit C++ scheduler binary
cpp/scheduler.exe

# ==========================================
# Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Virtual Environments
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Generated Scheduling Engine Outputs
# (Preserve output directory via .gitkeep)
# ==========================================
output/*
!output/.gitkeep

